From f61bbe12142273c1c643bc44919ee9e288ef3852 Mon Sep 17 00:00:00 2001
From: Tjari <zadigsm@outlook.com>
Date: Sun, 19 Apr 2026 13:28:15 +0700
Subject: [PATCH] write download progress to stderr

---
 samfwdl/fus.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/samfwdl/fus.py b/samfwdl/fus.py
index f27954b..ab11c02 100644
--- a/samfwdl/fus.py
+++ b/samfwdl/fus.py
@@ -113,10 +113,10 @@ def _render_progress(label: str, done: int, total: int, started_at: float, *, co
         percent = 0.0
         total_text = "?"
     line = f"{label}: {percent:6.2f}% {_format_bytes(done)}/{total_text} {_format_bytes(speed)}/s"
-    sys.stdout.write(f"\r\033[2K{line}")
+    sys.stderr.write(f"\r\033[2K{line}")
     if complete:
-        sys.stdout.write("\n")
-    sys.stdout.flush()
+        sys.stderr.write("\n")
+    sys.stderr.flush()
 
 
 def _pkcs7_unpad(data: bytes) -> bytes:
